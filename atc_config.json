{
  "backup_enabled": true,
  "backup_directory": "backups",
  "max_backups": 10,
  "fix_patterns": {
    "open_sql_syntax": [
      "SELECT\\s+.*\\s+FROM\\s+.*\\s+WHERE\\s+.*",
      "INSERT\\s+INTO\\s+.*\\s+VALUES\\s+.*",
      "UPDATE\\s+.*\\s+SET\\s+.*\\s+WHERE\\s+.*",
      "DELETE\\s+FROM\\s+.*\\s+WHERE\\s+.*",
      "SELECT\\s+.*\\s+FROM\\s+.*\\s+INTO\\s+.*",
      "SELECT\\s+.*\\s+FROM\\s+.*\\s+APPENDING\\s+.*",
      "SELECT\\s+.*\\s+FROM\\s+.*\\s+FOR\\s+ALL\\s+ENTRIES\\s+.*"
    ],
    "restricted_language": [
      "COMMIT\\s+WORK",
      "ROLLBACK\\s+WORK",
      "SY-SUBRC\\s*=",
      "SY-DBCNT\\s*=",
      "SY-TABIX\\s*=",
      "SY-INDEX\\s*=",
      "SY-LINNO\\s*=",
      "SY-PAGNO\\s*=",
      "SY-DATUM\\s*=",
      "SY-UZEIT\\s*=",
      "SY-UNAME\\s*=",
      "SY-MANDT\\s*=",
      "SY-VLINE\\s*=",
      "SY-COLNO\\s*=",
      "SY-REPID\\s*=",
      "SY-DYNNR\\s*=",
      "SY-TCODE\\s*=",
      "SY-MSGID\\s*=",
      "SY-MSGNO\\s*=",
      "SY-MSGTY\\s*=",
      "SY-MSGV1\\s*=",
      "SY-MSGV2\\s*=",
      "SY-MSGV3\\s*=",
      "SY-MSGV4\\s*="
    ],
    "abap_cloud_readiness": [
      "CALL\\s+FUNCTION\\s+.*\\s+DESTINATION\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+IN\\s+BACKGROUND\\s+TASK",
      "CALL\\s+FUNCTION\\s+.*\\s+STARTING\\s+NEW\\s+TASK",
      "CALL\\s+FUNCTION\\s+.*\\s+PERFORMING\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+IN\\s+UPDATE\\s+TASK",
      "CALL\\s+FUNCTION\\s+.*\\s+IN\\s+GROUP\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+EXCEPTIONS\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+CHANGING\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+IMPORTING\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+EXPORTING\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+TABLES\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+WITH\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+WITHOUT\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+WITH\\s+ERROR\\s+HANDLING",
      "CALL\\s+FUNCTION\\s+.*\\s+WITH\\s+NO\\s+ERROR\\s+HANDLING",
      "CALL\\s+FUNCTION\\s+.*\\s+WITH\\s+NO\\s+ERROR\\s+HANDLING\\s+IN\\s+UPDATE\\s+TASK",
      "CALL\\s+FUNCTION\\s+.*\\s+WITH\\s+NO\\s+ERROR\\s+HANDLING\\s+IN\\s+BACKGROUND\\s+TASK",
      "CALL\\s+FUNCTION\\s+.*\\s+WITH\\s+NO\\s+ERROR\\s+HANDLING\\s+IN\\s+GROUP\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+WITH\\s+NO\\s+ERROR\\s+HANDLING\\s+IN\\s+UPDATE\\s+TASK\\s+IN\\s+GROUP\\s+.*",
      "CALL\\s+FUNCTION\\s+.*\\s+WITH\\s+NO\\s+ERROR\\s+HANDLING\\s+IN\\s+BACKGROUND\\s+TASK\\s+IN\\s+GROUP\\s+.*"
    ]
  },
  "replacement_patterns": {
    "open_sql_syntax": {
      "SELECT": "SELECT_SINGLE",
      "INSERT": "INSERT_INTO",
      "UPDATE": "UPDATE_FROM",
      "DELETE": "DELETE_FROM",
      "SELECT_SINGLE": "SELECT_SINGLE",
      "SELECT_INTO": "SELECT_INTO",
      "SELECT_APPENDING": "SELECT_APPENDING",
      "SELECT_FOR_ALL_ENTRIES": "SELECT_FOR_ALL_ENTRIES"
    },
    "restricted_language": {
      "COMMIT WORK": "COMMIT WORK AND WAIT",
      "ROLLBACK WORK": "ROLLBACK WORK AND WAIT",
      "SY-SUBRC =": "IF sy-subrc <> 0",
      "SY-DBCNT =": "IF sy-dbcnt > 0",
      "SY-TABIX =": "IF sy-tabix > 0",
      "SY-INDEX =": "IF sy-index > 0",
      "SY-LINNO =": "IF sy-linno > 0",
      "SY-PAGNO =": "IF sy-pagno > 0",
      "SY-DATUM =": "IF sy-datum IS NOT INITIAL",
      "SY-UZEIT =": "IF sy-uzeit IS NOT INITIAL",
      "SY-UNAME =": "IF sy-uname IS NOT INITIAL",
      "SY-MANDT =": "IF sy-mandt IS NOT INITIAL",
      "SY-VLINE =": "IF sy-vline > 0",
      "SY-COLNO =": "IF sy-colno > 0",
      "SY-REPID =": "IF sy-repid IS NOT INITIAL",
      "SY-DYNNR =": "IF sy-dynnr IS NOT INITIAL",
      "SY-TCODE =": "IF sy-tcode IS NOT INITIAL",
      "SY-MSGID =": "IF sy-msgid IS NOT INITIAL",
      "SY-MSGNO =": "IF sy-msgno > 0",
      "SY-MSGTY =": "IF sy-msgty IS NOT INITIAL",
      "SY-MSGV1 =": "IF sy-msgv1 IS NOT INITIAL",
      "SY-MSGV2 =": "IF sy-msgv2 IS NOT INITIAL",
      "SY-MSGV3 =": "IF sy-msgv3 IS NOT INITIAL",
      "SY-MSGV4 =": "IF sy-msgv4 IS NOT INITIAL"
    },
    "abap_cloud_readiness": {
      "CALL FUNCTION": "CALL FUNCTION_IN_BACKGROUND",
      "CALL FUNCTION_IN_BACKGROUND": "CALL FUNCTION_IN_BACKGROUND",
      "CALL FUNCTION_IN_UPDATE_TASK": "CALL FUNCTION_IN_UPDATE_TASK",
      "CALL FUNCTION_IN_GROUP": "CALL FUNCTION_IN_GROUP",
      "CALL FUNCTION_WITH_EXCEPTIONS": "CALL FUNCTION_WITH_EXCEPTIONS",
      "CALL FUNCTION_WITH_CHANGING": "CALL FUNCTION_WITH_CHANGING",
      "CALL FUNCTION_WITH_IMPORTING": "CALL FUNCTION_WITH_IMPORTING",
      "CALL FUNCTION_WITH_EXPORTING": "CALL FUNCTION_WITH_EXPORTING",
      "CALL FUNCTION_WITH_TABLES": "CALL FUNCTION_WITH_TABLES",
      "CALL FUNCTION_WITH": "CALL FUNCTION_WITH",
      "CALL FUNCTION_WITHOUT": "CALL FUNCTION_WITHOUT",
      "CALL FUNCTION_WITH_ERROR_HANDLING": "CALL FUNCTION_WITH_ERROR_HANDLING",
      "CALL FUNCTION_WITH_NO_ERROR_HANDLING": "CALL FUNCTION_WITH_NO_ERROR_HANDLING",
      "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_UPDATE_TASK": "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_UPDATE_TASK",
      "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_BACKGROUND_TASK": "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_BACKGROUND_TASK",
      "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_GROUP": "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_GROUP",
      "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_UPDATE_TASK_IN_GROUP": "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_UPDATE_TASK_IN_GROUP",
      "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_BACKGROUND_TASK_IN_GROUP": "CALL FUNCTION_WITH_NO_ERROR_HANDLING_IN_BACKGROUND_TASK_IN_GROUP"
    }
  },
  "logging": {
    "level": "INFO",
    "file": "atc_automation.log",
    "max_size": "10MB",
    "backup_count": 5
  },
  "reporting": {
    "generate_html": true,
    "generate_json": true,
    "generate_csv": false,
    "include_backup_info": true,
    "include_fix_details": true
  },
  "sap_specific": {
    "abap_version": "7.55",
    "cloud_readiness_level": "HIGH",
    "restricted_language_mode": true,
    "open_sql_restrictions": true,
    "function_module_restrictions": true
  }
}